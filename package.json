{
  "name": "gtags-code",
  "displayName": "gtags-code",
  "icon": "gtags.png",
  "description": "gtags-code is a Visual Studio Code extension that integrates GNU Global (gtags) for efficient code navigation and symbol searching within your projects.",
  "publisher": "harikalyan",
  "version": "0.3.5",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Language Packs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hari-sh/gtags-code"
  },
  "main": "./dist/main.js",
  "contributes": {
    "configuration": {
      "title": "gtags-code configuration",
      "properties": {
        "gtags-code.globalCmd": {
          "type": "string",
          "default": "global",
          "description": "Path to the global executable"
        },
        "gtags-code.gtagsCmd": {
          "type": "string",
          "default": "gtags",
          "description": "Path to gtags executable."
        },
        "gtags-code.engine": {
          "type": "string",
          "enum": [
            "gtags",
            "external"
          ],
          "default": "gtags",
          "description": "Selects the code navigation engine."
        },
        "gtags-code.external.command": {
          "type": "string",
          "default": "",
          "description": "External MCP executable. Arrays using the legacy [executable, ...arguments] form are also supported."
        },
        "gtags-code.external.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Arguments passed to the external MCP executable. Use ${workspaceFolder} for the workspace path."
        },
        "gtags-code.external.index": {
          "type": "string",
          "default": "",
          "description": ""
        },
        "gtags-code.external.jump-to-definition": {
          "type": "string",
          "default": "",
          "description": ""
        },
        "gtags-code.external.search-symbols": {
          "type": "string",
          "default": "",
          "description": ""
        },
        "gtags-code.external.get-ref": {
          "type": "string",
          "default": "",
          "description": ""
        },
        "gtags-code.external.env": {
          "type": "string",
          "default": "",
          "description": ""
        },
        "gtags-code.external.get-callers": {
          "type": "string",
          "default": "",
          "description": ""
        }
      }
    },
    "commands": [
      {
        "command": "extension.storeTags",
        "title": "GTags: Store Tags"
      },
      {
        "command": "extension.jumpTag",
        "title": "GTags: Go To Definition"
      },
      {
        "command": "extension.searchTags",
        "title": "GTags: Search Tags"
      },
      {
        "command": "extension.getReferences",
        "title": "GTags: Get References"
      },
      {
        "command": "extension.getCallers",
        "title": "GTags: Get Callers"
      },
      {
        "command": "extension.gtagsCode",
        "title": "GTags: Open gtags-code"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "extension.jumpTag",
          "when": "editorTextFocus",
          "group": "navigation"
        },
        {
          "command": "extension.getReferences",
          "when": "editorTextFocus",
          "group": "navigation"
        },
        {
          "command": "extension.getCallers",
          "when": "editorTextFocus",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "gtags-panel",
          "title": "Gtags Code",
          "icon": "gtags.png"
        }
      ]
    },
    "views": {
      "gtags-panel": [
        {
          "type": "webview",
          "id": "gtags.panelView",
          "name": "gtags-code"
        }
      ]
    }
  },
  "scripts": {
    "bundle": "node build.js",
    "vscode:prepublish": "node build.js",
    "package": "vsce package",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "classic-level": "^3.0.0",
    "fast-glob": "^3.3.3",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2"
  }
}