{
  "name": "gtags-code",
  "displayName": "gtags-code",
  "icon": "gtags.png",
  "description": "gtags-code is a Visual Studio Code extension that integrates GNU Global (gtags) for efficient code navigation and symbol searching within your projects.",
  "publisher": "harikalyan",
  "version": "0.3.1",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Language Packs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hari-sh/gtags-code"
  },
  "activationEvents": [],
  "main": "./dist/main.js",
  "contributes": {
    "languageModelTools": [
      {
        "name": "gtags_get_definition",
        "displayName": "GTags: Get Symbol Definition",
        "modelDescription": "Get the definition (file path, line, and column) of a symbol (function, variable, type, etc.) from the workspace tags database.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "symbol": {
              "type": "string",
              "description": "The exact name of the symbol to query."
            }
          },
          "required": [
            "symbol"
          ]
        }
      },
      {
        "name": "gtags_search_symbols",
        "displayName": "GTags: Search Workspace Symbols",
        "modelDescription": "Search symbols in the workspace tags database matching a query term or pattern.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Partial name or search term for symbol lookup."
            },
            "limit": {
              "type": "number",
              "description": "Maximum number of results to return (default: 20)."
            }
          },
          "required": [
            "query"
          ]
        }
      },
      {
        "name": "gtags_get_references",
        "displayName": "GTags: Find Symbol References",
        "modelDescription": "Find all references of a symbol, function, variable, or member expression (supporting obj->field or obj.field) across the workspace using GNU Global.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "symbol": {
              "type": "string",
              "description": "The symbol or member expression to query references for (e.g. foo, obj->field, obj.field)."
            }
          },
          "required": [
            "symbol"
          ]
        }
      }
    ],
    "configuration": {
      "title": "gtags-code configuration",
      "properties": {
        "gtags-code.globalCmd": {
          "type": "string",
          "default": "global",
          "description": "Path to the global executable"
        },
        "gtags-code.gtagsCmd": {
          "type": "string",
          "default": "gtags",
          "description": "Path to gtags executable."
        },
        "gtags-code.ctagsCmd": {
          "type": "string",
          "default": "ctags",
          "description": "Path to ctags executable. If not set, variable indexing will be skipped."
        }
      }
    },
    "commands": [
      {
        "command": "extension.storeTags",
        "title": "GTags: Store Tags"
      },
      {
        "command": "extension.jumpTag",
        "title": "GTags: Go To Definition"
      },
      {
        "command": "extension.searchTags",
        "title": "GTags: Search Tags"
      },
      {
        "command": "extension.getReferences",
        "title": "GTags: Get References"
      },
      {
        "command": "extension.getCallers",
        "title": "GTags: Get Callers"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "extension.jumpTag",
          "when": "editorTextFocus",
          "group": "navigation"
        },
        {
          "command": "extension.getReferences",
          "when": "editorTextFocus",
          "group": "navigation"
        },
        {
          "command": "extension.getCallers",
          "when": "editorTextFocus",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "bundle": "node build.js",
    "vscode:prepublish": "node build.js",
    "package": "vsce package",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "classic-level": "^3.0.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.25.5"
  }
}